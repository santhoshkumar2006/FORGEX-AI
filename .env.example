# SafeReplay Environment Configuration

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3001

# AI Provider Configuration ("mock" | "openai" | "gemini")
AI_PROVIDER=mock
# Optional API Key for external AI analysis (Mock AI provider used by default if omitted)
# AI_API_KEY=your_gemini_or_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration (Optional PostgreSQL connection - in-memory SQLite/fallback used by default)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/safereplay

# Privacy & Replay Settings
DATA_RETENTION_HOURS=24
MASK_INPUTS_DEFAULT=true
ENABLE_PERFORMANCE_METRICS=true
MAX_PAYLOAD_SIZE_BYTES=1048576
