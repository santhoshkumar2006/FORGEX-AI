{
  "name": "safereplay-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "SafeReplay - Privacy-Preserving AI-Assisted Web Debugging Platform",
  "workspaces": [
    "shared",
    "replay-sdk",
    "server",
    "demo-app",
    "dashboard"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "dev:server": "npm run dev --workspace=server",
    "dev:demo": "npm run dev --workspace=demo-app",
    "dev:dashboard": "npm run dev --workspace=dashboard",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "test:shared": "npm run test --workspace=shared",
    "test:sdk": "npm run test --workspace=replay-sdk",
    "test:server": "npm run test --workspace=server",
    "test:demo": "npm run test --workspace=demo-app",
    "test:dashboard": "npm run test --workspace=dashboard",
    "test:e2e": "vitest run tests/e2e.test.ts",
    "lint": "npm run lint --workspaces"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
